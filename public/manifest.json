{
  "manifest_version": 3,
  "name": "Draftab",
  "description": "A markdown block notepad in your new tab.",
  "version": "0.1.0",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
