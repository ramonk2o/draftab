{
  "manifest_version": 3,
  "name": "Draftab",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
